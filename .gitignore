# Object files / archives
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll

# Native CLI executable (Linux/macOS Make build)
sudokusolver
sudokusolver.exe

# Object-file output dir (keep the dir via .gitkeep, ignore everything else)
obj/*
!obj/.gitkeep

